<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Build for net8.0 but RUN on whatever major runtime the machine has. Without this, a machine with only
         the .NET 9 or .NET 10 runtime installed refuses to start a net8.0 app ("framework 'Microsoft.NETCore.App'
         version '8.0.0' was not found"), which forces every user onto an extra runtime install they don't
         otherwise need. Targeting net8.0 stays deliberate: it is the lowest runtime we support, and a lower
         target runs on more machines, not fewer. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!-- Installing this as a global dotnet tool puts a real `codemap` command on PATH, with no shell alias and no
       profile edit (see README) — which matters on locked-down machines where editing the PowerShell profile,
       or writing to a machine-wide PATH, is blocked by policy. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>codemap</ToolCommandName>
    <PackageId>CodeMap.Cli</PackageId>
    <Version>1.0.0</Version>
    <!-- PackageVersion (not Version) carries the timestamp: Version also drives AssemblyVersion, and a
         yyMMdd/HHmm value there overflows the 65534 max per-component and fails the build (CS7034). NuGet only
         reinstalls a global tool when the package version changes, and every prior local build produced the
         same "1.0.0", so a "tool update" from source silently kept the old binary even after a fresh pack.
         A build-time timestamp makes every pack a distinct, always-newer version. -->
    <PackageVersion>1.$([System.DateTime]::UtcNow.ToString(yyMMdd)).$([System.DateTime]::UtcNow.ToString(HHmm))</PackageVersion>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\nupkg</PackageOutputPath>
    <Description>Offline .NET codebase index for AI assistants: scan a solution and query "what does changing this affect?"</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeMap.Roslyn\CodeMap.Roslyn.csproj" />
    <ProjectReference Include="..\CodeMap.Query\CodeMap.Query.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeMap.Tests" />
  </ItemGroup>

</Project>
